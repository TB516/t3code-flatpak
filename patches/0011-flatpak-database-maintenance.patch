+        Effect.provideService(HostProcess.Environment, {
+          T3CODE_FLATPAK_SERVER: "/installed/flatpak/t3code",
+        }),
+      );
+      assert.equal(yield* fs.readFileString(legacy), "retained rollback database");
+      const mode = yield* Effect.flatMap(
+        SqlClient.SqlClient,
+        (sql) => sql<{ auto_vacuum: number }>`PRAGMA auto_vacuum`,
+      ).pipe(Effect.provide(NodeSqliteClient.layer({ filename: dbPath, readonly: true })));
+      assert.equal(mode[0]?.auto_vacuum, 2);
+    }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
