index 0000000000..dc19d91042
--- /dev/null
+++ b/apps/desktop/src/app/DesktopDatabaseMaintenance.test.ts
@@ -0,0 +1,195 @@
+import { assert, afterEach, it, vi } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Sink from "effect/Sink";
+import * as Stream from "effect/Stream";
+import * as ChildProcess from "effect/process/ChildProcess";
+import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";
+
+import * as DesktopDatabaseMaintenance from "./DesktopDatabaseMaintenance.ts";
+import * as DesktopEnvironment from "./DesktopEnvironment.ts";
+import * as DesktopState from "./DesktopState.ts";
+import * as DesktopBackendPool from "../backend/DesktopBackendPool.ts";
+import * as ElectronDialog from "../electron/ElectronDialog.ts";
+import * as ElectronWindow from "../electron/ElectronWindow.ts";
+
+const runtime = "/installed Flatpak/files/t3code";
+const baseDir = "/home/alice/.var/app/com.t3tools.t3code/data/t3";
+afterEach(() => vi.unstubAllEnvs());
+
+const harness = Effect.fn("test.databaseMaintenance.harness")(function* (
+  options: {
+    runtime?: string;
+    response?: number;
+    exitCode?: number;
+    ready?: boolean;
+    confirm?: Effect.Effect<void>;
+    stoppedPid?: number;
+  } = {},
+) {
+  vi.stubEnv("FLATPAK_ID", "com.t3tools.t3code");
+  vi.stubEnv("T3CODE_FLATPAK_RUNTIME", options.runtime ?? runtime);
+  const order: string[] = [];
+  const errors: string[] = [];
+  const commands: ChildProcess.Command[] = [];
+  let stopped = false;
+  const primary: DesktopBackendPool.DesktopBackendInstance = {
+    id: DesktopBackendPool.PRIMARY_INSTANCE_ID,
+    label: Effect.succeed("Local"),
+    currentConfig: Effect.succeedNone,
+    snapshot: Effect.sync(() => ({
+      desiredRunning: !stopped,
+      ready: !stopped,
+      activePid: stopped ? Option.fromNullishOr(options.stoppedPid) : Option.some(123),
+      restartAttempt: 0,
+      restartScheduled: false,
+    })),
+    stop: () =>
+      Effect.sync(() => {
+        order.push("stop");
+        stopped = true;
+      }),
+    start: Effect.sync(() => {
+      order.push("start");
+      stopped = false;
+    }),
+    waitForReady: () =>
+      Effect.sync(() => {
+        order.push("ready");
+        return options.ready ?? true;
+      }),
+  };
+  const dialog = ElectronDialog.ElectronDialog.of({
+    pickFolder: () => Effect.die("unexpected folder picker"),
+    pickFiles: () => Effect.die("unexpected file picker"),
+    showMessageBox: (input) =>
+      Effect.gen(function* () {
+        const confirm = input.type === "question";
+        order.push(confirm ? "confirm" : "success");
+        if (confirm && options.confirm) yield* options.confirm;
+        return { response: confirm ? (options.response ?? 1) : 0, checkboxChecked: false };
+      }),
+    showErrorBox: (_title, message) =>
+      Effect.sync(() => {
+        order.push("error");
+        errors.push(message);
+      }),
+  });
+  const spawner = ChildProcessSpawner.make((command) =>
+    Effect.sync(() => {
+      assert.isTrue(stopped, "cleanup must not start before the server stops");
+      order.push("compact");
+      commands.push(command);
+      const stdout = Stream.make(new TextEncoder().encode("Database: 2 GiB -> 1 GiB."));
+      const stderr = Stream.make(new TextEncoder().encode("Not enough disk space."));
+      return ChildProcessSpawner.makeHandle({
+        pid: ChildProcessSpawner.ProcessId(456),
+        stdout,
+        stderr,
+        all: stdout,
+        exitCode: Effect.succeed(ChildProcessSpawner.ExitCode(options.exitCode ?? 0)),
+        isRunning: Effect.succeed(false),
+        kill: () => Effect.void,
+        stdin: Sink.drain,
+        getInputFd: () => Sink.drain,
+        getOutputFd: () => Stream.empty,
+        unref: Effect.succeed(Effect.void),
+      });
+    }),
+  );
+  const maintenance = yield* DesktopDatabaseMaintenance.make.pipe(
+    Effect.provide(
+      Layer.mergeAll(
+        DesktopBackendPool.layerTest([primary]),
+        DesktopState.layer,
+        Layer.succeed(DesktopEnvironment.DesktopEnvironment, {
+          platform: "linux",
+          baseDir,
+        } as DesktopEnvironment.DesktopEnvironment["Service"]),
+        Layer.succeed(ElectronDialog.ElectronDialog, dialog),
+        Layer.mock(ElectronWindow.ElectronWindow)({
+          currentMainOrFirst: Effect.succeedNone,
+        }),
+        Layer.succeed(ChildProcessSpawner.ChildProcessSpawner, spawner),
+      ),
+    ),
+  );
+  return { maintenance, order, errors, commands };
+});
+
+it.effect(
+  "stops the server, cleans only its own database, and restarts before reporting success",
+  () =>
+    Effect.gen(function* () {
+      const { maintenance, order, commands } = yield* harness();
+      yield* maintenance.compact;
+      assert.deepEqual(order, ["confirm", "stop", "compact", "start", "ready", "success"]);
+      const command = commands[0]!;
+      assert.equal(command._tag, "StandardCommand");
+      if (command._tag !== "StandardCommand") return;
+      assert.equal(command.command, "/usr/bin/flatpak-spawn");
+      assert.deepEqual(command.args.slice(-3), [
+        "/bin/sh",
+        `${runtime}/host-server.sh`,
+        "--compact-database",
+      ]);
+      assert.include(command.args, `--env=T3CODE_FLATPAK_SERVER=${runtime}/t3code`);
+      assert.include(command.args, `--env=T3CODE_HOME=${baseDir}`);
+    }),
+);
+
+it.effect("cancelling the confirmation leaves the server running", () =>
+  Effect.gen(function* () {
+    const { maintenance, order } = yield* harness({ response: 0 });
+    yield* maintenance.compact;
+    assert.deepEqual(order, ["confirm"]);
+  }),
+);
+
+it.effect("restarts after cleanup failure and reports the actual failure", () =>
+  Effect.gen(function* () {
+    const { maintenance, order, errors } = yield* harness({ exitCode: 1 });
+    yield* maintenance.compact;
+    assert.deepEqual(order, ["confirm", "stop", "compact", "start", "ready", "error"]);
+    assert.include(errors[0]!, "Not enough disk space.");
+    assert.include(errors[0]!, "The local server has restarted.");
+  }),
+);
+
+it.effect("does not run maintenance when the server has not exited", () =>
+  Effect.gen(function* () {
+    const { maintenance, order, commands } = yield* harness({ stoppedPid: 123 });
+    yield* maintenance.compact;
+    assert.deepEqual(order, ["confirm", "stop", "start", "ready", "error"]);
+    assert.equal(commands.length, 0);
+  }),
+);
+
+it.effect("ignores a second request while confirmation is open", () =>
+  Effect.gen(function* () {
+    const opened = yield* Deferred.make<void>();
+    const proceed = yield* Deferred.make<void>();
+    const { maintenance, order } = yield* harness({
+      confirm: Deferred.succeed(opened, undefined).pipe(Effect.andThen(Deferred.await(proceed))),
+    });
+    const first = yield* maintenance.compact.pipe(Effect.forkChild);
+    yield* Deferred.await(opened);
+    yield* maintenance.compact;
+    yield* Deferred.succeed(proceed, undefined);
+    yield* Fiber.join(first);
+    assert.equal(order.filter((entry) => entry === "compact").length, 1);
+    assert.equal(order.filter((entry) => entry === "confirm").length, 1);
+  }).pipe(Effect.scoped),
+);
+
+it.effect("does not expose cleanup without a Flatpak runtime", () =>
+  Effect.gen(function* () {
+    const { maintenance, order } = yield* harness({ runtime: "" });
+    assert.isFalse(maintenance.supported);
+    yield* maintenance.compact;
+    assert.deepEqual(order, []);
+  }),
+);
diff --git a/apps/desktop/src/app/DesktopDatabaseMaintenance.ts b/apps/desktop/src/app/DesktopDatabaseMaintenance.ts
new file mode 100644
index 0000000000..c718d5a964
--- /dev/null
+++ b/apps/desktop/src/app/DesktopDatabaseMaintenance.ts
@@ -0,0 +1,173 @@
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import * as ChildProcess from "effect/process/ChildProcess";
+import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";
+
+import * as DesktopEnvironment from "./DesktopEnvironment.ts";
+import * as DesktopState from "./DesktopState.ts";
+import { flatpakAppId } from "./Flatpak.ts";
+import * as DesktopBackendPool from "../backend/DesktopBackendPool.ts";
+import * as ElectronDialog from "../electron/ElectronDialog.ts";
+import * as ElectronWindow from "../electron/ElectronWindow.ts";
+
+class DesktopDatabaseCleanupError extends Schema.TaggedError<DesktopDatabaseCleanupError>()(
+  "DesktopDatabaseCleanupError",
+  { message: Schema.String },
+) {}
+
+/** Coordinates offline cleanup of the Flatpak desktop's own database. */
+export class DesktopDatabaseMaintenance extends Context.Service<
+  DesktopDatabaseMaintenance,
+  {
+    readonly supported: boolean;
+    readonly compact: Effect.Effect<void>;
+  }
+>()("@t3tools/desktop/app/DesktopDatabaseMaintenance") {}
+
+/** @public Service construction is part of the canonical Effect module API. */
+export const make = Effect.gen(function* () {
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const pool = yield* DesktopBackendPool.DesktopBackendPool;
+  const dialog = yield* ElectronDialog.ElectronDialog;
+  const windows = yield* ElectronWindow.ElectronWindow;
+  const state = yield* DesktopState.DesktopState;
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const busy = yield* Ref.make(false);
+  const runtime = process.env.T3CODE_FLATPAK_RUNTIME;
+  const supported =
+    flatpakAppId(process.env, environment.platform) !== null && runtime?.startsWith("/") === true;
+
+  const compact = Effect.gen(function* () {
+    if (!supported || !runtime || (yield* Ref.get(state.quitting))) return;
+    if (yield* Ref.getAndSet(busy, true)) return;
+    yield* Effect.gen(function* () {
+      const owner = Option.getOrUndefined(yield* windows.currentMainOrFirst);
+      const confirmation = yield* dialog.showMessageBox(
+        {
+          type: "question",
+          title: "Reclaim database space",
+          message: "Reclaim space and restart the local server?",
+          detail:
+            "Finish active work first. T3 Code will temporarily disconnect while its local server stops and database cleanup runs. This can take several minutes and needs temporary disk space. The old rollback database will be kept.",
+          buttons: ["Cancel", "Reclaim space and restart"],
+          defaultId: 0,
+          cancelId: 0,
+          noLink: true,
+        },
+        owner,
+      );
+      if (confirmation.response !== 1 || (yield* Ref.get(state.quitting))) return;
+      const primary = yield* pool.primary;
+      const snapshot = yield* primary.snapshot;
+      if (!snapshot.ready) {
+        yield* dialog.showErrorBox(
+          "Database cleanup unavailable",
+          "Wait for the local server to finish starting, then try again.",
+        );
+        return;
+      }
+
+      // Run the installed package directly on the host, with no CLI launcher or service install.
+      const result = yield* Effect.gen(function* () {
+        yield* primary.stop();
+        const stopped = yield* primary.snapshot;
+        if (Option.isSome(stopped.activePid)) {
+          return yield* Effect.fail(
+            new DesktopDatabaseCleanupError({
+              message: "The local server did not stop. Database cleanup was not started.",
+            }),
+          );
+        }
+        return yield* Effect.scoped(
+          Effect.gen(function* () {
+            const child = yield* spawner.spawn(
+              ChildProcess.make(
+                "/usr/bin/flatpak-spawn",
+                [
+                  "--host",
+                  "--watch-bus",
+                  `--directory=${runtime}`,
+                  `--env=T3CODE_HOME=${environment.baseDir}`,
+                  `--env=T3CODE_FLATPAK_SERVER=${runtime}/t3code`,
+                  `--env=T3CODE_FLATPAK_ENTRY=${runtime}/resources/app.asar/apps/server/dist/bin.mjs`,
+                  `--env=T3CODE_FLATPAK_COMPILE_CACHE=${runtime}/resources/app.asar/apps/desktop/dist-electron/compileCache.cjs`,
+                  "/bin/sh",
+                  `${runtime}/host-server.sh`,
+                  "--compact-database",
+                ],
+                { stdin: "ignore" },
+              ),
+            );
+            const [output, errors, code] = yield* Effect.all(
+              [
+                child.stdout.pipe(Stream.decodeText(), Stream.mkString),
+                child.stderr.pipe(Stream.decodeText(), Stream.mkString),
+                child.exitCode,
+              ],
+              { concurrency: "unbounded" },
+            );
+            if (code !== 0) {
+              return yield* Effect.fail(
+                new DesktopDatabaseCleanupError({
+                  message: errors.trim() || output.trim() || "Database cleanup failed.",
+                }),
+              );
+            }
+            return output.trim();
+          }),
+        );
+      }).pipe(
+        Effect.ensuring(
+          Effect.gen(function* () {
+            if (!(yield* Ref.get(state.quitting))) yield* primary.start;
+          }),
+        ),
+        Effect.exit,
+      );
+      if (yield* Ref.get(state.quitting)) return;
+      const ready = yield* primary.waitForReady(Duration.seconds(60));
+      if (Exit.isFailure(result)) {
+        const error = Cause.squash(result.cause);
+        yield* dialog.showErrorBox(
+          "Database cleanup failed",
+          `${error instanceof Error ? error.message : String(error)}\n\n${ready ? "The local server has restarted." : "The local server has not become ready. Close and reopen T3 Code to retry starting it."}`,
+        );
+        return;
+      }
+      yield* dialog.showMessageBox(
+        {
+          type: ready ? "info" : "warning",
+          title: "Database cleanup complete",
+          message: ready
+            ? "Database space reclaimed. The local server has restarted."
+            : "Database space reclaimed, but the local server has not become ready.",
+          detail:
+            result.value +
+            (ready ? "" : "\nClose and reopen T3 Code to retry starting the server."),
+          buttons: ["OK"],
+        },
+        owner,
+      );
+    }).pipe(Effect.ensuring(Ref.set(busy, false)));
+  }).pipe(
+    Effect.catchCause((cause) => {
+      const error = Cause.squash(cause);
+      return dialog.showErrorBox(
+        "Database cleanup failed",
+        error instanceof Error ? error.message : String(error),
+      );
+    }),
+    Effect.withSpan("desktop.databaseMaintenance.compact"),
+  );
+  return DesktopDatabaseMaintenance.of({ supported, compact });
+});
+
+export const layer = Layer.effect(DesktopDatabaseMaintenance, make);
