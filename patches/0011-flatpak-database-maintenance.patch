@@ -0,0 +1,23 @@
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import * as DesktopDatabaseMaintenance from "../../app/DesktopDatabaseMaintenance.ts";
+import * as IpcChannels from "../channels.ts";
+import { makeIpcMethod, makeSyncIpcMethod } from "../DesktopIpc.ts";
+
+export const getDatabaseMaintenanceSupported = makeSyncIpcMethod({
+  channel: IpcChannels.DATABASE_MAINTENANCE_SUPPORTED_CHANNEL,
+  result: Schema.Boolean,
+  handler: Effect.fn("desktop.ipc.databaseMaintenance.supported")(function* () {
+    return (yield* DesktopDatabaseMaintenance.DesktopDatabaseMaintenance).supported;
+  }),
+});
+
+export const compactDatabase = makeIpcMethod({
+  channel: IpcChannels.DATABASE_MAINTENANCE_COMPACT_CHANNEL,
+  payload: Schema.Void,
+  result: Schema.Void,
+  handler: Effect.fn("desktop.ipc.databaseMaintenance.compact")(function* () {
+    yield* (yield* DesktopDatabaseMaintenance.DesktopDatabaseMaintenance).compact;
+  }),
+});
