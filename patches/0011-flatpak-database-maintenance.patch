diff --git a/apps/desktop/src/ipc/methods/databaseMaintenance.ts b/apps/desktop/src/ipc/methods/databaseMaintenance.ts
new file mode 100644
index 0000000000..00cb4b9191
--- /dev/null
+++ b/apps/desktop/src/ipc/methods/databaseMaintenance.ts
@@ -0,0 +1,33 @@
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import * as DesktopDatabaseMaintenance from "../../app/DesktopDatabaseMaintenance.ts";
+import * as IpcChannels from "../channels.ts";
+import { makeIpcMethod, makeSyncIpcMethod } from "../DesktopIpc.ts";
+
+export const getDatabaseMaintenanceSupported = makeSyncIpcMethod({
+  channel: IpcChannels.DATABASE_MAINTENANCE_SUPPORTED_CHANNEL,
+  result: Schema.Boolean,
+  handler: Effect.fn("desktop.ipc.databaseMaintenance.supported")(function* () {
+    return (yield* DesktopDatabaseMaintenance.DesktopDatabaseMaintenance).supported;
+  }),
+});
+
+export const getLegacyDatabaseBytes = makeIpcMethod({
+  channel: IpcChannels.DATABASE_MAINTENANCE_LEGACY_BYTES_CHANNEL,
+  payload: Schema.Void,
+  result: Schema.NullOr(Schema.Number),
+  handler: Effect.fn("desktop.ipc.databaseMaintenance.legacyDatabaseBytes")(function* () {
+    return yield* (yield* DesktopDatabaseMaintenance.DesktopDatabaseMaintenance)
+      .legacyDatabaseBytes;
+  }),
+});
+
+export const runDatabaseMaintenance = makeIpcMethod({
+  channel: IpcChannels.DATABASE_MAINTENANCE_RUN_CHANNEL,
+  payload: Schema.Struct({ reclaimSpace: Schema.Boolean }),
+  result: Schema.Void,
+  handler: Effect.fn("desktop.ipc.databaseMaintenance.run")(function* (input) {
+    yield* (yield* DesktopDatabaseMaintenance.DesktopDatabaseMaintenance).run(input);
