+it.effect(
+  "the Flatpak desktop command compacts its database without a service and keeps the rollback database",
+  () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const baseDir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-flatpak-compact-" });
