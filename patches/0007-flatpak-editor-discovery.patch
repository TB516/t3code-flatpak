+// Flatpak does not export an editor's usual CLI command to the host PATH.
+// Keep these IDs next to discovery so the same installed app is launched.
+const FLATPAK_EDITOR_APP_IDS: Partial<Record<EditorId, readonly string[]>> = {
+  vscode: ["com.visualstudio.code"],
+  "vscode-insiders": ["com.visualstudio.code.insiders"],
+  vscodium: ["com.vscodium.codium"],
+  zed: ["dev.zed.Zed", "dev.zed.Zed-Preview"],
+  idea: ["com.jetbrains.IntelliJ-IDEA-Ultimate", "com.jetbrains.IntelliJ-IDEA-Community"],
+  clion: ["com.jetbrains.CLion"],
+  datagrip: ["com.jetbrains.DataGrip"],
+  goland: ["com.jetbrains.GoLand"],
+  phpstorm: ["com.jetbrains.PhpStorm"],
+  pycharm: ["com.jetbrains.PyCharm-Professional", "com.jetbrains.PyCharm-Community"],
+  rider: ["com.jetbrains.Rider"],
+  rubymine: ["com.jetbrains.RubyMine"],
+  rustrover: ["com.jetbrains.RustRover"],
+  webstorm: ["com.jetbrains.WebStorm"],
+};
+
+const installedFlatpakAppIds = Effect.fn("externalLauncher.installedFlatpakAppIds")(function* (
+  platform: NodeJS.Platform,
+  env: NodeJS.ProcessEnv,
+): Effect.fn.Return<
+  ReadonlySet<string>,
+  never,
+  FileSystem.FileSystem | Path.Path | ChildProcessSpawner.ChildProcessSpawner
+> {
+  if (platform !== "linux" || !(yield* isCommandAvailable("flatpak", { env }))) {
+    return new Set<string>();
+  }
+
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  return yield* spawner
+    .spawn(
+      ChildProcess.make("flatpak", ["list", "--app", "--columns=application"], {
+        stdin: "ignore",
+        stderr: "ignore",
+      }),
+    )
+    .pipe(
+      Effect.flatMap((handle) =>
+        Effect.all([handle.stdout.pipe(Stream.decodeText(), Stream.mkString), handle.exitCode], {
+          concurrency: "unbounded",
+        }),
+      ),
+      Effect.map(([stdout, exitCode]) =>
+        exitCode === 0 ? new Set(stdout.split("\n").map((id) => id.trim())) : new Set<string>(),
+      ),
+      Effect.scoped,
+      Effect.timeout("2 seconds"),
+      Effect.orElseSucceed(() => new Set<string>()),
+    );
+});
+
+function installedFlatpakEditorAppId(
+  editor: EditorId,
+  installedApps: ReadonlySet<string>,
+): string | undefined {
+  return FLATPAK_EDITOR_APP_IDS[editor]?.find((appId) => installedApps.has(appId));
+}
