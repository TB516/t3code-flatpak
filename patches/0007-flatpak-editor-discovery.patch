+it.effect.skipIf(windowsHost)("discovers and launches Flatpak editors without host commands", () =>
+  Effect.gen(function* () {
+    const fileSystem = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const binDir = yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-flatpak-editors-" });
+    const flatpakPath = path.join(binDir, "flatpak");
+    yield* fileSystem.writeFileString(flatpakPath, "#!/bin/sh\n");
+    yield* fileSystem.chmod(flatpakPath, 0o755);
+
+    const spawned: ChildProcess.StandardCommand[] = [];
+    const available = yield* Effect.gen(function* () {
+      const launcher = yield* ExternalLauncher.ExternalLauncher;
+      const editors = yield* launcher.resolveAvailableEditors();
+      yield* launcher.launchEditor({ editor: "zed", cwd: "/home/alice/project" });
+      yield* launcher.launchEditor({ editor: "vscode", cwd: "/home/alice/project/src/main.ts:12" });
+      yield* launcher.launchEditor({ editor: "idea", cwd: "/home/alice/project" });
+      return editors;
+    }).pipe(
+      Effect.provide(
+        testLayer({
+          platform: "linux",
+          env: { PATH: binDir },
+          onSpawn: (command) => spawned.push(command),
+          spawnResult: (command) =>
+            command.command === "flatpak" && command.args[0] === "list"
+              ? {
+                  stdout:
+                    "dev.zed.Zed\ncom.visualstudio.code\ncom.jetbrains.IntelliJ-IDEA-Community\n",
+                }
+              : undefined,
+        }),
+      ),
+    );
+
+    assert.ok(available.includes("zed"));
+    assert.ok(available.includes("vscode"));
+    assert.ok(available.includes("idea"));
+    assert.ok(!available.includes("vscodium"));
+    assert.deepEqual(
+      spawned.filter((command) => command.args[0] === "run").map((command) => command.args),
+      [
+        ["run", "dev.zed.Zed", "/home/alice/project"],
+        ["run", "com.visualstudio.code", "--goto", "/home/alice/project/src/main.ts:12"],
+        ["run", "com.jetbrains.IntelliJ-IDEA-Community", "/home/alice/project"],
+      ],
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
