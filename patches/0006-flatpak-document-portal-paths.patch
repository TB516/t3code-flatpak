+// @effect-diagnostics nodeBuiltinImport:off -- This native bridge wraps its errors at the public boundary.
+import { execFileSync } from "node:child_process";
+import * as NodePath from "node:path";
+
 import * as Context from "effect/Context";
 import * as Effect from "effect/Effect";
 import * as Layer from "effect/Layer";
@@ -6,6 +10,49 @@ import * as Schema from "effect/Schema";
 
 import * as Electron from "electron";
 
+import { flatpakAppId } from "../app/Flatpak.ts";
+
+/**
+ * Pickers and drops can return a document portal path, but the server runs on the host.
+ * The host service's PATH is small, so sh finds `flatpak` with the user's captured PATH.
+ */
+export function resolveHostPath(path: string): string {
+  const runtimeDir = process.env.XDG_RUNTIME_DIR;
+  if (
+    flatpakAppId(process.env, process.platform) === null ||
+    !runtimeDir ||
+    !path.startsWith(`${runtimeDir}/doc/`)
+  ) {
+    return path;
+  }
+
+  const hostPath = process.env.T3CODE_FLATPAK_HOST_PATH;
+  const stdout = execFileSync(
+    "/usr/bin/flatpak-spawn",
+    [
+      "--host",
+      "--directory=/",
+      "--env=LC_ALL=C",
+      ...(hostPath ? [`--env=PATH=${hostPath}`] : []),
+      "/bin/sh",
+      "-c",
+      'exec flatpak document-info "$1"',
+      "sh",
+      path,
+    ],
+    { encoding: "utf8", timeout: 2000, stdio: ["ignore", "pipe", "ignore"] },
+  );
+  const origin = stdout
+    .split("\n")
+    .find((line) => line.startsWith("origin: "))
+    ?.slice("origin: ".length)
+    .replace(/\r$/, "");
+  if (!origin || !NodePath.isAbsolute(origin)) {
+    throw new Error("Flatpak could not resolve the selected path to a host path.");
+  }
+  return origin;
+}
+
