+    return folderPath;
+  }
+
+  const stdout = yield* Effect.tryPromise({
+    try: () =>
+      new Promise<string>((resolve, reject) => {
+        execFile(
+          "/usr/bin/flatpak-spawn",
+          [
+            "--host",
+            "--directory=/",
+            "--env=LC_ALL=C",
+            "/usr/bin/flatpak",
+            "document-info",
+            folderPath,
+          ],
+          (error, stdout) => {
+            if (error) {
+              reject(error);
+              return;
+            }
+            resolve(stdout);
+          },
+        );
+      }),
+    catch: (cause) => new Error("Flatpak could not query the selected folder.", { cause }),
+  });
+  const origin = stdout
+    .split("\n")
+    .find((line) => line.startsWith("origin: "))
+    ?.slice("origin: ".length)
+    .replace(/\r$/, "");
+  if (!origin || !NodePath.isAbsolute(origin)) {
+    return yield* Effect.fail(
+      new Error("Flatpak could not resolve the selected folder to a host path."),
+    );
+  }
+  return origin;
+});
