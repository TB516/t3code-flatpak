+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { afterEach, beforeEach, vi } from "vite-plus/test";
+
+import * as ElectronDialog from "./ElectronDialog.ts";
+
+const { showOpenDialogMock, execFileMock } = vi.hoisted(() => ({
+  showOpenDialogMock: vi.fn(),
+  execFileMock: vi.fn(),
+}));
+
+vi.mock("node:child_process", () => ({ execFileSync: execFileMock }));
+
+vi.mock("electron", () => ({
+  dialog: {
+    showOpenDialog: showOpenDialogMock,
+  },
+}));
+
+describe("ElectronDialog", () => {
+  beforeEach(() => {
+    showOpenDialogMock.mockReset();
+    execFileMock.mockReset();
+  });
+
+  afterEach(() => vi.unstubAllEnvs());
+
+  it.effect("returns the host path for a Flatpak folder picker selection", () =>
+    Effect.gen(function* () {
+      vi.stubEnv("FLATPAK_ID", "com.t3tools.t3code");
+      vi.stubEnv("XDG_RUNTIME_DIR", "/run/user/1000");
+      showOpenDialogMock.mockResolvedValue({
+        canceled: false,
+        filePaths: ["/run/user/1000/doc/document-id/packslip-packages"],
+      });
+      vi.stubEnv("T3CODE_FLATPAK_HOST_PATH", "/home/alice/.nix-profile/bin:/usr/bin");
+      execFileMock.mockReturnValue(
+        "id: document-id\norigin: /home/alice/Projects/packslip-packages\n",
+      );
+      const dialog = yield* ElectronDialog.ElectronDialog;
+
+      const path = yield* dialog.pickFolder({
+        owner: Option.none(),
+        defaultPath: Option.none(),
+      });
+
+      assert.equal(Option.getOrThrow(path), "/home/alice/Projects/packslip-packages");
+      assert.deepEqual(execFileMock.mock.calls[0]?.slice(0, 2), [
+        "/usr/bin/flatpak-spawn",
+        [
+          "--host",
+          "--directory=/",
+          "--env=LC_ALL=C",
+          "--env=PATH=/home/alice/.nix-profile/bin:/usr/bin",
+          "/bin/sh",
+          "-c",
+          'exec flatpak document-info "$1"',
+          "sh",
+          "/run/user/1000/doc/document-id/packslip-packages",
+        ],
+      ]);
+    }).pipe(Effect.provide(ElectronDialog.layer)),
+  );
+
+  it("leaves ordinary paths alone without asking the host", () => {
+    vi.stubEnv("FLATPAK_ID", "com.t3tools.t3code");
+    vi.stubEnv("XDG_RUNTIME_DIR", "/run/user/1000");
+
+    assert.equal(ElectronDialog.resolveHostPath("/home/alice/project"), "/home/alice/project");
+    assert.equal(execFileMock.mock.calls.length, 0);
+  });
+
+  it.effect("reports an unresolved Flatpak folder through the typed picker error", () =>
+    Effect.gen(function* () {
+      vi.stubEnv("FLATPAK_ID", "com.t3tools.t3code");
+      vi.stubEnv("XDG_RUNTIME_DIR", "/run/user/1000");
+      showOpenDialogMock.mockResolvedValue({
+        canceled: false,
+        filePaths: ["/run/user/1000/doc/document-id/project"],
+      });
+      execFileMock.mockReturnValue("id: document-id\n");
+      const dialog = yield* ElectronDialog.ElectronDialog;
+
+      const error = yield* Effect.flip(
+        dialog.pickFolder({ owner: Option.none(), defaultPath: Option.none() }),
+      );
+
+      assert.instanceOf(error, ElectronDialog.ElectronDialogPickFolderError);
+      assert.instanceOf(error.cause, Error);
+      assert.include((error.cause as Error).message, "could not resolve");
+    }).pipe(Effect.provide(ElectronDialog.layer)),
+  );
+});
