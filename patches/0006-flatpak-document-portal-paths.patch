+import { flatpakAppId } from "../app/Flatpak.ts";
+
+/** The folder picker can return a document portal path, but the server runs on the host. */
+const resolveHostFolderPath = Effect.fn("desktop.electron.dialog.resolveHostFolderPath")(function* (
+  folderPath: string,
+) {
+  const runtimeDir = process.env.XDG_RUNTIME_DIR;
+  if (
+    flatpakAppId(process.env, process.platform) === null ||
+    !runtimeDir ||
+    !folderPath.startsWith(`${runtimeDir}/doc/`)
