+
+function LegacyDatabaseRow({
+  bytes,
+  remove,
+}: {
+  readonly bytes: number;
+  readonly remove: () => Promise<void>;
+}) {
+  const gt = useGT();
+  const [confirming, setConfirming] = useState(false);
+  const [removing, setRemoving] = useState(false);
+  const amount = formatMiB(bytes);
+  const start = async () => {
+    setConfirming(false);
+    setRemoving(true);
+    try {
+      await remove();
+    } catch (error) {
+      toastManager.add({
+        type: "error",
+        title: gt("Could not delete the old database"),
+        description: error instanceof Error ? error.message : gt("An error occurred."),
+      });
+    } finally {
+      setRemoving(false);
+    }
+  };
+  return (
+    <SettingsRow
+      title={gt("Database from before 0.1.0")}
+      description={gt("{amount} kept for rolling back to versions before 0.1.0.", { amount })}
+      control={
+        <>
+          <Button
+            variant="outline"
+            size="xs"
+            disabled={removing}
+            onClick={() => setConfirming(true)}
+          >
+            {removing ? gt("Deleting…") : gt("Delete old database")}
+          </Button>
+          <AlertDialog open={confirming} onOpenChange={setConfirming}>
+            <AlertDialogPopup>
+              <AlertDialogHeader>
+                <AlertDialogTitle>
+                  <T>Delete the database from before 0.1.0?</T>
+                </AlertDialogTitle>
+                <AlertDialogDescription>
+                  <T>
+                    Frees <Var>{amount}</Var>. Your threads and settings are already in the current
+                    database. T3 Code versions before 0.1.0 will start with no threads or settings.
+                  </T>
+                </AlertDialogDescription>
+              </AlertDialogHeader>
+              <AlertDialogFooter>
+                <AlertDialogClose render={<Button variant="outline" />}>
+                  <T>Cancel</T>
+                </AlertDialogClose>
+                <Button variant="destructive" onClick={() => void start()}>
+                  <T>Delete database</T>
+                </Button>
+              </AlertDialogFooter>
+            </AlertDialogPopup>
+          </AlertDialog>
+        </>
+      }
+    />
+  );
+}
