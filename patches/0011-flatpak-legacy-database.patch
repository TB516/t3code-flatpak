diff --git a/apps/desktop/src/ipc/methods/legacyDatabase.ts b/apps/desktop/src/ipc/methods/legacyDatabase.ts
new file mode 100644
index 0000000000..277e1908ca
--- /dev/null
+++ b/apps/desktop/src/ipc/methods/legacyDatabase.ts
@@ -0,0 +1,54 @@
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Schema from "effect/Schema";
+
+import * as DesktopEnvironment from "../../app/DesktopEnvironment.ts";
+import { flatpakAppId } from "../../app/Flatpak.ts";
+import * as IpcChannels from "../channels.ts";
+import { makeIpcMethod, makeSyncIpcMethod } from "../DesktopIpc.ts";
+
+// Upstream deletes the database kept from before 0.1.0 only through `t3 doctor`, which the
+// Flatpak does not install. It sits in the app's own data, next to statev2.sqlite.
+const legacyDatabasePath = Effect.map(DesktopEnvironment.DesktopEnvironment, (environment) =>
+  environment.path.join(environment.stateDir, "state.sqlite"),
+);
+
+export const getLegacyDatabaseSupported = makeSyncIpcMethod({
+  channel: IpcChannels.LEGACY_DATABASE_SUPPORTED_CHANNEL,
+  result: Schema.Boolean,
+  handler: Effect.fn("desktop.ipc.legacyDatabase.supported")(function* () {
+    const environment = yield* DesktopEnvironment.DesktopEnvironment;
+    return flatpakAppId(yield* HostProcess.Environment, environment.platform) !== null;
+  }),
+});
+
+export const getLegacyDatabaseBytes = makeIpcMethod({
+  channel: IpcChannels.LEGACY_DATABASE_BYTES_CHANNEL,
+  payload: Schema.Void,
+  result: Schema.NullOr(Schema.Number),
+  handler: Effect.fn("desktop.ipc.legacyDatabase.bytes")(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    return yield* fs.stat(yield* legacyDatabasePath).pipe(
+      Effect.map((info) => Number(info.size)),
+      Effect.orElseSucceed(() => null),
+    );
+  }),
+});
+
+export const removeLegacyDatabase = makeIpcMethod({
+  channel: IpcChannels.LEGACY_DATABASE_REMOVE_CHANNEL,
+  payload: Schema.Void,
+  result: Schema.Void,
+  handler: Effect.fn("desktop.ipc.legacyDatabase.remove")(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const legacy = yield* legacyDatabasePath;
+    // Only versions before 0.1.0 open it. As upstream does, delete the database before its WAL
+    // so a failed unlink keeps its commits.
+    yield* Effect.forEach(
+      ["", "-wal", "-shm"],
+      (suffix) => fs.remove(legacy + suffix, { force: true }),
+      { discard: true },
+    );
+  }),
+});
