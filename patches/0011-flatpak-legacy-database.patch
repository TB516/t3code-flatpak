+
+function LegacyDatabaseRow({
+  bytes,
+  remove,
+}: {
+  readonly bytes: number;
+  readonly remove: () => Promise<void>;
+}) {
+  const [confirming, setConfirming] = useState(false);
+  const [removing, setRemoving] = useState(false);
+  const start = async () => {
+    setConfirming(false);
+    setRemoving(true);
+    try {
+      await remove();
+    } catch (error) {
+      toastManager.add({
+        type: "error",
+        title: "Could not delete the old database",
+        description: error instanceof Error ? error.message : "An error occurred.",
+      });
+    } finally {
+      setRemoving(false);
+    }
+  };
+  return (
+    <SettingsRow
+      title="Database from before 0.1.0"
+      description={`${formatMiB(bytes)} kept for rolling back to versions before 0.1.0.`}
+      control={
+        <>
+          <Button
+            variant="outline"
+            size="xs"
+            disabled={removing}
+            onClick={() => setConfirming(true)}
+          >
+            {removing ? "Deleting…" : "Delete old database"}
+          </Button>
+          <AlertDialog open={confirming} onOpenChange={setConfirming}>
+            <AlertDialogPopup>
+              <AlertDialogHeader>
+                <AlertDialogTitle>Delete the database from before 0.1.0?</AlertDialogTitle>
+                <AlertDialogDescription>
+                  Frees {formatMiB(bytes)}. Your threads and settings are already in the current
+                  database. T3 Code versions before 0.1.0 will start with no threads or settings.
+                </AlertDialogDescription>
+              </AlertDialogHeader>
+              <AlertDialogFooter>
+                <AlertDialogClose render={<Button variant="outline" />}>Cancel</AlertDialogClose>
+                <Button variant="destructive" onClick={() => void start()}>
+                  Delete database
+                </Button>
+              </AlertDialogFooter>
+            </AlertDialogPopup>
+          </AlertDialog>
+        </>
+      }
+    />
+  );
+}
