diff --git a/apps/desktop/src/app/Flatpak.ts b/apps/desktop/src/app/Flatpak.ts
new file mode 100644
index 000000000..006f94e00
--- /dev/null
+++ b/apps/desktop/src/app/Flatpak.ts
@@ -0,0 +1,5 @@
+/** The package owns Linux desktop registration and updates inside Flatpak. */
+export function flatpakAppId(env: NodeJS.ProcessEnv, platform: NodeJS.Platform): string | null {
+  if (platform !== "linux") return null;
+  return env.FLATPAK_ID?.trim() || null;
+}
