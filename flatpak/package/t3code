#!/bin/sh
set -eu
umask 077
unset ELECTRON_RUN_AS_NODE
export ZYPAK_DISABLE_SANDBOX=1

: "${FLATPAK_ID:?This launcher must run inside Flatpak}"
: "${XDG_DATA_HOME:?Flatpak must supply its app data directory}"

export T3CODE_HOME="$XDG_DATA_HOME/t3"

# Use this instance's deployment so the desktop and server stay on the same
# version even when Flatpak installs an update while the app is running.
app_path=$(awk '
    /^\[/ { in_instance = ($0 == "[Instance]") }
    in_instance && /^app-path=/ { sub(/^app-path=/, ""); print; exit }
' /.flatpak-info)
case "$app_path" in
    /*) export T3CODE_FLATPAK_RUNTIME="$app_path/t3code" ;;
    *) echo "Flatpak did not provide the installed app path." >&2; exit 1 ;;
esac

# The host service activation environment has a deliberately small PATH. Read
# the user's login environment before Electron opens any protocol descriptors,
# then pass only PATH back to the host server through flatpak-spawn. The
# desktop also takes the login shell's telemetry opt-out, as upstream's does.
# Startup files can print first, so the values are the last two lines.
host_env=$(
    /usr/bin/flatpak-spawn --host "${SHELL:-/bin/sh}" -ilc \
        'printf "%s\n%s" "${T3CODE_TELEMETRY_ENABLED-}" "$PATH"' \
        3>&- 4>&- 5>&- 6>&- 7>&- 2>/dev/null || true
)
newline='
'
host_path=${host_env##*"$newline"}
host_telemetry=${host_env%"$newline"*}
host_telemetry=${host_telemetry##*"$newline"}
if [ -n "$host_telemetry" ] && [ -z "${T3CODE_TELEMETRY_ENABLED-}" ]; then
    export T3CODE_TELEMETRY_ENABLED="$host_telemetry"
fi
if [ -n "$host_path" ]; then
    export T3CODE_FLATPAK_HOST_PATH="$host_path"
fi

# The sandbox has no camera devices, so the browser panel asks for the camera
# through the desktop's camera portal instead.
exec zypak-wrapper /app/t3code/t3code --enable-features=WebRtcPipeWireCamera "$@"
